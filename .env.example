# Lead email notifications (server-side only; never prefix with NEXT_PUBLIC_).
# Every valid quote-form submission is emailed to LEAD_NOTIFICATION_EMAIL.
# Without RESEND_API_KEY the lead is written to the server log instead.
# Get a key at https://resend.com. The sender domain must be verified in
# Resend before the owner receives mail from it.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=markali7550@gmail.com
LEAD_EMAIL_FROM="Lead alerts <leads@your-verified-domain.com>"
